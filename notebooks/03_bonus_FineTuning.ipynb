import re
from tqdm import tqdm
from sklearn.metrics import cohen_kappa_score

# 1. Siapkan 20 data sampel yang sama untuk dievaluasi
# Catatan: Agar adil, pastikan df_eksperimen ini diambil dari data yang terpisah 
# atau data test jika ada, namun untuk replikasi kita pakai 20 data dari df utama.
df_eksperimen = df.copy() # df di notebook LoRA sudah di-sample(20) di awal

prediksi_lora = []

print("Memulai evaluasi model LoRA pada 20 esai...")

# 2. Loop untuk memprediksi skor menggunakan model yang telah di-finetune
for index, row in tqdm(df_eksperimen.iterrows(), total=df_eksperimen.shape[0]):
    esai_target = row['full_text']
    
    # Format prompt harus persis sama dengan format saat training (tanpa label score tentunya)
    prompt_eval = f"""
You are an expert essay grader.

Essay:
{esai_target}

Give a score from 1 to 6 only.
"""
    
    # Tokenisasi input dan pindahkan ke GPU
    inputs = tokenizer(prompt_eval, return_tensors="pt").to("cuda")
    
    # Ambil output dari model
    with torch.no_grad(): # Tambahkan no_grad agar hemat memori GPU saat inferensi
        outputs = model.generate(
            **inputs,
            max_new_tokens=5, # Cukup 5 token karena kita hanya butuh angka skor
            temperature=0.0,   # Set ke 0.0 agar jawaban konsisten
            do_sample=False
        )
    
    # Decode hasil jawaban
    hasil_teks = tokenizer.decode(outputs[0], skip_special_tokens=True)
    
    # Potong teks untuk mengambil bagian setelah prompt (respon baru dari model)
    # Kita cari angka 1-6 yang muncul setelah teks prompt asli
    respon_saja = hasil_teks[len(prompt_eval):]
    
    # Ekstraksi menggunakan Regex untuk mencari angka 1 sampai 6
    match = re.search(r'[1-6]', respon_saja)
    if match:
        skor = int(match.group())
    else:
        skor = 3 # Fallback nilai tengah jika model tidak mengeluarkan angka yang valid
        
    prediksi_lora.append(skor)

# 3. Simpan hasil ke dalam kolom baru
df_eksperimen['lora_score'] = prediksi_lora
print("\nEvaluasi model LoRA selesai!")

# 4. Tampilkan tabel perbandingan nilai asli guru vs tebakan AI LoRA
display(df_eksperimen[['full_text', 'score', 'lora_score']].head(20))

print("\n" + "="*40)

# 5. Hitung Skor QWK (Quadratic Weighted Kappa) untuk model LoRA
qwk_lora = cohen_kappa_score(
    df_eksperimen['score'].astype(int), 
    df_eksperimen['lora_score'], 
    weights='quadratic'
)

print(f"=== HASIL EVALUASI QWK LoRA (20 Sampel) ===")
print(f"Skor QWK LoRA : {qwk_lora:.4f}")
print("==========================================")
