import os
import re
import torch
import pandas as pd
from tqdm import tqdm
from datasets import Dataset
from sklearn.metrics import cohen_kappa_score
from transformers import AutoTokenizer, AutoModelForCausalLM, TrainingArguments, Trainer
from peft import LoraConfig, get_peft_model
from huggingface_hub import login

# ==========================================
# 1. AUTENTIKASI & INITIAL SETUP
# ==========================================
# Silakan login ke HuggingFace jika model membutuhkan token akses
print("Mengautentikasi Hugging Face Hub...")
login()

# Bersihkan cache GPU agar VRAM optimal
torch.cuda.empty_cache()

# ==========================================
# 2. MEMUAT & MENYIAPKAN DATASET (20 SAMPLES)
# ==========================================
print("\nMemuat dataset...")
try:
    df = pd.read_csv("train.csv")
    print(f"Dataset asli berhasil dimuat! Total data: {df.shape[0]} baris.")
except FileNotFoundError:
    print("Error: File 'train.csv' tidak ditemukan. Pastikan file berada di direktori yang sama.")
    exit()

# Seleksi kolom, bersihkan missing values, dan ambil 20 sampel data (seperti di notebook LoRA asli)
df = df[['full_text', 'score']].dropna()
df = df.sample(20, random_state=42) # random_state di-set agar sampel data konsisten saat dievaluasi
print(f"Mengambil 20 sampel esai untuk eksperimen cepat.")

# Fungsi untuk memformat teks esai menjadi prompt instruksi
def make_prompt(row):
    prompt = f"""
You are an expert essay grader.

Essay:
{row['full_text']}

Give a score from 1 to 6 only.
"""
    return {
        "text": prompt,
        "label": int(row['score'])
    }

# Transformasikan dataframe menjadi list of dictionary
data = df.apply(make_prompt, axis=1).tolist()

# ==========================================
# 3. LOAD MODEL & TOKENIZER (TINYLLAMA)
# ==========================================
model_name = "TinyLlama/TinyLlama-1.1B-Chat-v1.0"
print(f"\nMemuat Tokenizer dan Model: {model_name}...")

tokenizer = AutoTokenizer.from_pretrained(model_name)
tokenizer.pad_token = tokenizer.eos_token

model = AutoModelForCausalLM.from_pretrained(
    model_name,
    device_map="auto"
)

# ==========================================
# 4. CONFIGURASI PEFT / LoRA
# ==========================================
print("\nMengonfigurasi parameter LoRA...")
config = LoraConfig(
    r=8,
    lora_alpha=16,
    target_modules=["q_proj", "v_proj"],
    lora_dropout=0.1,
    bias="none",
    task_type="CAUSAL_LM"
)

model = get_peft_model(model, config)
model.print_trainable_parameters()

# ==========================================
# 5. DATA PREPARATION & TOKENIZATION
# ==========================================
print("\nMelakukan tokenisasi pada dataset...")
dataset = Dataset.from_list(data)

def tokenize(example):
    # Gabungkan teks instruksi prompt dengan target label skor untuk training Causal LM
    text = example["text"] + " Score: " + str(example["label"])

    tokens = tokenizer(
        text,
        truncation=True,
        padding="max_length",
        max_length=128
    )

    tokens["labels"] = tokens["input_ids"].copy()
    return tokens

dataset = dataset.map(tokenize)
dataset.set_format(
    type="torch",
    columns=["input_ids", "attention_mask", "labels"]
)

# ==========================================
# 6. TRAINING PROCESS (FINETUNING VIA LORA)
# ==========================================
print("\nMenyiapkan argumen training...")
training_args = TrainingArguments(
    output_dir="./results",
    report_to="none",
    per_device_train_batch_size=1,
    num_train_epochs=1,
    logging_steps=10,
    save_steps=50,
    learning_rate=2e-4
)

trainer = Trainer(
    model=model,
    args=training_args,
    train_dataset=dataset
)

print("\nMemulai proses Finetuning LoRA...")
trainer.train()

# Simpan adapter model hasil finetuning dan tokenizer-nya
print("\nMenyimpan model LoRA yang telah di-finetune...")
model.save_pretrained("aes-lora-model")
tokenizer.save_pretrained("aes-lora-model")

# ==========================================
# 7. EVALUASI ALUR ZERO/FEW-SHOT & HITUNG QWK
# ==========================================
print("\n" + "="*50)
print("MEMULAI EVALUASI PERFORMA MODEL LORA (Mekanisme ala Zero/Few-Shot)")
print("="*50)

df_eksperimen = df.copy()
prediksi_lora = []

# Proses inferensi satu-persatu pada 20 data sampel dengan model yang sudah di-finetune
for index, row in tqdm(df_eksperimen.iterrows(), total=df_eksperimen.shape[0]):
    esai_target = row['full_text']
    
    # Bungkus kembali ke prompt instruksi murni tanpa menyertakan label 'score' asli
    prompt_eval = f"""
You are an expert essay grader.

Essay:
{esai_target}

Give a score from 1 to 6 only.
"""
    
    # Tokenisasi dan kirim ke GPU
    inputs = tokenizer(prompt_eval, return_tensors="pt").to("cuda")
    
    # Inferensi model dengan mematikan perhitungan gradien agar hemat VRAM
    with torch.no_grad():
        outputs = model.generate(
            **inputs,
            max_new_tokens=5,   # Hanya butuh token pendek penentu nilai angka skor
            temperature=0.0,    # Set 0.0 agar output teks bersifat deterministik/konsisten
            do_sample=False
        )
    
    # Decode token menjadi teks mentah
    hasil_teks = tokenizer.decode(outputs[0], skip_special_tokens=True)
    
    # Pisahkan teks jawaban baru model dari rangkaian prompt aslinya
    respon_saja = hasil_teks[len(prompt_eval):]
    
    # Cari pola karakter angka 1 hingga 6 di dalam respon baru model menggunakan Regex
    match = re.search(r'[1-6]', respon_saja)
    if match:
        skor = int(match.group())
    else:
        skor = 3  # Fallback nilai tengah jika model tidak mematuhi aturan format angka
        
    prediksi_lora.append(skor)

# Masukkan hasil prediksi model ke kolom baru di data eksperimen
df_eksperimen['lora_score'] = prediksi_lora

print("\nEvaluasi Model LoRA Selesai!")
print("\n--- PERBANDINGAN SKOR ASLI vs PREDIKSI LORA ---")
# Menampilkan rangkuman teks esai (dipotong), skor guru, dan skor prediksi model LoRA
df_tampil = df_eksperimen.copy()
df_tampil['full_text'] = df_tampil['full_text'].str.slice(0, 50) + "..."
print(df_tampil[['full_text', 'score', 'lora_score']].to_string())

# Hitung metrik reliabilitas Quadratic Weighted Kappa (QWK)
qwk_lora = cohen_kappa_score(
    df_eksperimen['score'].astype(int), 
    df_eksperimen['lora_score'], 
    weights='quadratic'
)

print("\n" + "="*45)
print(f"=== HASIL AKHIR EVALUASI METRIK PERFORMANCE ===")
print(f"Skor QWK Model LoRA (20 Sampel): {qwk_lora:.4f}")
print("="*45)
